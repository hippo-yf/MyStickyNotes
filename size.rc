#include <windows.h>
#pragma code_page(65001)
200 DIALOGEX 0,0,185,62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选区字号"
FONT 9,"Microsoft YaHei UI"
BEGIN
 CONTROL "",201,"msctls_trackbar32",WS_TABSTOP,5,7,114,21
 RTEXT "12",202,123,11,28,12
 LTEXT "pt",-1,159,11,17,12
 DEFPUSHBUTTON "确定",IDOK,76,37,48,17
 PUSHBUTTON "取消",IDCANCEL,130,37,48,17
END

1 ICON "sticky.ico"

#include "version.h"
1 VERSIONINFO
FILEVERSION NOTE_FILE_VERSION
PRODUCTVERSION NOTE_FILE_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileVersion", NOTE_VERSION
   VALUE "ProductVersion", NOTE_VERSION
   VALUE "ProductName", "MyStickyNotes"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
